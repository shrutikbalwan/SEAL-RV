TOPLEVEL_LANG = verilog
SIM ?= icarus
TOPLEVEL = cpu_core
COCOTB_TEST_MODULES = test_rv32i
COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps

REPO_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
SIM_BUILD = $(REPO_ROOT)/build/cocotb
COCOTB_RESULTS_FILE = $(SIM_BUILD)/results.xml
PYTHONPATH := $(REPO_ROOT)/verification/cocotb:$(PYTHONPATH)
export PYTHONPATH
VERILOG_SOURCES = $(REPO_ROOT)/hw/rtl/cpu/alu.sv \
                  $(REPO_ROOT)/hw/rtl/cpu/regfile.sv \
                  $(REPO_ROOT)/hw/rtl/cpu/rvc_decompress.sv \
                  $(REPO_ROOT)/hw/rtl/security/seal_pmp.sv \
                  $(REPO_ROOT)/hw/rtl/security/pmp_checker.sv \
                  $(REPO_ROOT)/hw/rtl/cpu/cpu_core.sv

include $(shell cocotb-config --makefiles)/Makefile.sim
