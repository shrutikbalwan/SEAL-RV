synth -top wb_interconnect
stat
write_verilog -noattr build/wb_interconnect_synth.v

design -reset
read_verilog -sv hw/rtl/security/wb_firewall.sv hw/rtl/bus/wb_error_slave.sv hw/rtl/bus/wb_address_decoder.sv hw/rtl/bus/wb_arbiter.sv hw/rtl/bus/wb_interconnect.sv hw/rtl/bus/wb_cpu_adapter.sv
